# Copy this file to .env.development.local for local work, or set the same
# variables in the Vercel dashboard for Production and Preview. Never commit
# real values: .env, .env.* and *.local are ignored by git.
#
# The site currently runs with NO accounts: talent and employer signups go to
# two Google Forms (see src/config/signup-links.ts) and the auth API answers 410.
# Every variable below that belongs to the accounts feature is OPTIONAL and can
# be left unset; the build and the deployment run without any of them. Set them
# only when re-enabling accounts (AUTH_ENABLED=true).

# --- Accounts switch --------------------------------------------------------
# Off by default. Leave unset (or "false") to keep the built-in signup, login
# and dashboard flows disabled and the Google Form links live. Set to "true" to
# turn the accounts API back on - then fill in every value below.
AUTH_ENABLED="false"

# --- Postgres (Neon through the Vercel integration) -------------------------
# Needed by the accounts API (when AUTH_ENABLED=true) AND by the public forms
# that store what visitors send: event registration, consultation booking,
# written enquiries and the newsletter signup. With no DATABASE_URL those forms
# ask /api/forms/availability on load and show a "not available right now" notice
# with a way to get in touch before anyone fills them in, and still answer 503 if
# one is submitted anyway. Putting this back is all it takes to turn them on
# again: the notice reads this same variable, so there is no second switch.
# The app reads DATABASE_URL. The migration script prefers DATABASE_URL_UNPOOLED
# so schema changes do not run through the connection pooler.
# Keep sslmode=require so traffic to the database stays encrypted.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Content admin (/admin/content) -----------------------------------------
# Managers publish and edit posts from the admin panel, and this is also needed
# for the public /blog and /events pages: without DATABASE_URL there is nothing to read,
# so the feed shows its empty state.
#
# BLOB_READ_WRITE_TOKEN is NOT typed in by hand. Create a Blob store in the Vercel
# project (Storage > Create > Blob) and Vercel adds this variable to the project
# for you. Until it is set, /api/admin/upload answers 503 and the editor's image
# button says uploads are unavailable; everything else in the panel still works.
# The store may be created Public or Private - the access mode is fixed once it
# exists, and uploads detect which one it is. A private store is read back
# through /api/media/... by the site, since a browser cannot fetch it directly.
BLOB_READ_WRITE_TOKEN=""
#
# Managers are not created through a variable. There is no MANAGER_EMAILS
# allowlist: run `npm run promote:manager you@example.com` against this
# DATABASE_URL. Public signup can never produce a manager.

# --- Sessions -- only if auth is on -----------------------------------------
# At least 32 characters of random hex. Run `npm run setup:auth` to generate one.
# Rotating this value signs every user out.
JWT_SECRET=""

# --- Audit log -- only if auth is on ----------------------------------------
# Optional extra salt for the IP hashes in auth_events. Falls back to JWT_SECRET.
AUDIT_HASH_SECRET=""

# --- Transactional email (Resend) -- only if auth is on ---------------------
# Without RESEND_API_KEY, verification and reset links are printed to the server
# console outside production, and nothing is sent in production.
RESEND_API_KEY=""
EMAIL_FROM="People Growth Africa <noreply@mail.peoplegrowthafrica.com>"
# Old name for EMAIL_FROM, still read as a fallback if EMAIL_FROM is unset.
# Leave this one empty on a new setup.
AUTH_EMAIL_FROM=""

# --- Rate limiting (Upstash Redis) -- only if auth is on --------------------
# Without these, rate limits are counted per serverless instance instead of
# globally, which is much weaker.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Lead notifications -----------------------------------------------------
# Optional. Where a submitted enquiry or newsletter signup is announced. Defaults
# to hello@peoplegrowthafrica.com when unset.
LEAD_INBOX=""

# --- Links and origins ------------------------------------------------------
# Used to build the links inside emails. Never read from the request host.
APP_URL="https://www.peoplegrowthafrica.com"
# Older names, read only when APP_URL is unset. NEXT_PUBLIC_ is a Next.js
# leftover - this is a Vite app, and the prefix does not expose anything here.
# Leave both empty on a new setup.
SITE_URL=""
NEXT_PUBLIC_SITE_URL=""
# Extra origins allowed to send credentialed requests, comma separated. Use this
# for a custom preview domain; *.vercel.app and localhost are allowed already.
APP_ORIGINS=""

# --- Sheet content for the blog and events (no database) -------------------
# The /blog and /events pages read extra posts and events from a Google Sheet
# published to the web as CSV.
# Publish ONLY the tab called "Live": that tab holds just the approved rows, and
# its URL is the one that belongs here. File > Share > Publish to web > the tab
# > Comma-separated values (.csv). See docs/content-from-sheets.md for the full
# setup, including the column headers the sheet must have.
#
# Leave it unset and the site still builds and deploys: the built-in blog and
# event content renders exactly as before. The value is a secret-ish URL - anyone with
# it can read the sheet - so it is never logged and never sent to the browser.
SHEET_CSV_URL=""

# --- Manual refresh of the published posts feed -----------------------------
# Optional. The sheet content refreshes itself every five minutes at the edge,
# so normal publishing needs nothing here. Setting this turns on
#   POST /api/revalidate   with header  x-revalidate-secret: <this value>
# which clears the cached copy immediately. Any long random string works; the
# endpoint answers 503 while this is unset rather than accepting anything.
REVALIDATE_SECRET=""

# --- Staff admin: first-party traffic and scheduled cleanup ----------------
# A long random string used only on the server to hash a visitor for one day.
# It never reaches the browser. Rotating it just starts a new unique count.
TRAFFIC_HASH_SALT=""
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>` to
# /api/cron/traffic-cleanup. The endpoint is closed while it is unset.
CRON_SECRET=""

# --- One-time administrator seed (scripts/seed-admin.mjs only) -------------
# Do not set these in Vercel. Pass them on the command line once:
#   ADMIN_EMAIL=admin@peoplegrowthafrica.com ADMIN_TEMP_PASSWORD='...' npm run seed:admin
ADMIN_EMAIL=""
ADMIN_TEMP_PASSWORD=""
