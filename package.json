    "bcryptjs": "3.0.3",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "jose": "6.2.12",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "resend": "6.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
