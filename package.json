{
  "name": "pga-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-static-files.mjs && tsc -b && vite build && vite build --config vite.ssr.config.ts && node scripts/prerender.mjs",
    "lint": "oxlint",
    "images": "node scripts/optimize-images.js",
    "setup:auth": "node scripts/setup-auth.mjs",
    "setup:content": "node scripts/setup-content.mjs",
    "promote:manager": "node scripts/promote-manager.mjs",
    "serve:api": "node scripts/api-server.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:auth:gate": "node scripts/test-auth-gate.mjs",
    "test:auth:ui": "node scripts/test-auth-ui.mjs",
    "test:newsletter": "node scripts/test-newsletter.mjs",
    "test:leads": "node scripts/test-leads.mjs",
    "test:content": "node scripts/test-content.mjs",
    "test:content-admin": "node scripts/test-content-admin.mjs",
    "test:published": "node scripts/test-published.mjs",
    "test:seo": "node scripts/test-seo.mjs",
    "test:crawl": "node scripts/test-crawl.mjs",
    "test:dashboard:rules": "node scripts/test-dashboard-rules.mjs",
    "test:dashboard": "npm run test:dashboard:rules && node scripts/test-dashboard.mjs",
    "check:api": "node scripts/check-api-imports.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "3.0.3",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "jose": "6.2.12",
    "papaparse": "^5.5.3",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "resend": "6.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "20.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.86.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.2"
  }
}
